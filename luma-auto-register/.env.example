# ---- Luma account ----
# The account used to register for events (passwordless login).
LUMA_EMAIL=howard.linra@gmail.com

# ---- Gmail (for reading the Luma login OTP code) ----
# Use a Google "App Password", NOT your normal password.
# Create one at: https://myaccount.google.com/apppasswords
# (2-Step Verification must be enabled on the account first.)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_ADDRESS=howard.linra@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---- Discovery ----
# Comma-separated lu.ma city slugs to scan, e.g. sf,nyc,la
# Find the slug from the city's discover URL, e.g. https://lu.ma/sf  ->  sf
LUMA_CITIES=sf

# Optional: only register for events whose title/description contains one of
# these comma-separated keywords (case-insensitive). Leave empty to register
# for ALL free events found on the discover page(s).
KEYWORD_FILTER=

# ---- Behavior ----
# true  = real run (clicks Register on free events)
# false-equivalents handled by --dry-run flag instead.
HEADLESS=true

# How often to re-scan when running in --loop mode (minutes).
POLL_INTERVAL_MINUTES=30

# Max number of events to register in a single scan (safety cap).
MAX_REGISTRATIONS_PER_RUN=15

# ---- Private / invited events ----
# Also scan the Gmail inbox for Luma invitation emails and auto-register those.
# This is how PRIVATE (unlisted) events are found — they never appear on the
# public discover pages. Set to false to disable.
SCAN_INBOX_INVITES=true
INVITE_LOOKBACK_DAYS=30
